{
  "openapi": "3.0.3",
  "info": { "title": "有据 Agent API", "version": "1.0.0", "description": "从《高性价比人生指南》翻一条有出处的签，并展开为决策账。" },
  "paths": {
    "/functions/v1/app": {
      "post": {
        "summary": "调用有据的三个工具",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": {
            "type": "object",
            "required": ["action", "tool"],
            "properties": {
              "action": { "type": "string", "enum": ["agent"] },
              "tool": { "type": "string", "enum": ["ask_life_question", "get_daily_sign", "get_book_meta"] },
              "input": { "type": "object", "properties": { "question": { "type": "string", "maxLength": 200 } } }
            }
          } } }
        },
        "responses": { "200": { "description": "签 / 展开账 / 元数据" } }
      }
    }
  }
}
